# Server
NODE_ENV=development
PORT=3000

# MongoDB — provide the full connection string.
MONGODB_URI=
MONGODB_DATABASE=rider_app

# Optional: override the DNS resolvers used by Node's bundled resolver
# (c-ares) before connecting. Needed on some Windows setups where Node reads
# a stale resolver list (e.g. 127.0.0.1) from the registry while the OS uses
# the correct public resolvers. Comma-separated, e.g. 1.1.1.1,1.0.0.1.
MONGODB_DNS_SERVERS=

# Auth (JWT in httpOnly cookie)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
MASTER_ADMIN_EMAIL=admin@ehatid.com

# OTP email — Gmail SMTP via nodemailer.
# SMTP_PASS must be a Gmail App Password, NOT your normal password:
#   1. Enable 2-Step Verification on the Google account.
#   2. Google Account > Security > App passwords > create one for "Mail".
#   3. Paste the 16-character code below (spaces are fine).
# Port 465 uses SSL (secure=true); the mailer switches automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E-Hatid <you@gmail.com>"

# Geo service (delivery fee / distance)
GEO_SERVICE_URL=http://localhost:8000
GEO_DISTANCE_TIMEOUT_MS=3000

# OTP throttling
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_EMAIL_WINDOW=5
OTP_RATE_WINDOW_MS=600000

# Order lifecycle
ORDER_AUTO_CANCEL_MINUTES=30
